# ==============================================
# MUVERA LUXURY COMMERCE ENVIRONMENT CONFIGURATION
# ==============================================

# --- Business & WhatsApp Gateway ---
NEXT_PUBLIC_WHATSAPP_NUMBER=919380933170
NEXT_PUBLIC_BUSINESS_NAME="MUVERA Luxury Streetwear"
NEXT_PUBLIC_BUSINESS_UPI_ID=muvera.store@upi
NEXT_PUBLIC_SUPPORT_EMAIL=support@muvera.club
NEXT_PUBLIC_DEFAULT_LOCATION="Indiranagar Dark Store (Bengaluru)"

# --- Storefront & Shipping Rules ---
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_PAISE=99900    # Free delivery above ₹999 (99900 paise)
NEXT_PUBLIC_EXPRESS_DELIVERY_FEE_PAISE=9900        # ₹99 express delivery fee (9900 paise)
NEXT_PUBLIC_HOLD_EXPIRY_MINUTES=15                 # 15-minute stock reservation hold

# --- Database (MongoDB Mongoose & In-Memory Fallback) ---
MONGODB_URI=                                       # Leave blank for local in-memory DB or provide mongodb+srv://...

# --- Cloudinary Image Storage ---
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo

# --- Authentication & Admin Security ---
ADMIN_SECRET_KEY=muvera_admin_master_secret_2026
NEXTAUTH_SECRET=muvera_nextauth_jwt_super_secret_key
NEXTAUTH_URL=http://localhost:3000

# --- Scheduled Background Jobs & Cron Security ---
CRON_SECRET=muvera_cron_secret_internal_2026

# --- Transactional Email & Password Reset (Brevo / Console) ---
EMAIL_PROVIDER=console                              # 'console' for dev/tests (prints link to terminal), 'brevo' for production
BREVO_API_KEY=                                      # Brevo (Sendinblue) API key
EMAIL_FROM_ADDRESS=security@muvera.club
EMAIL_FROM_NAME="MUVERA Security"
NEXT_PUBLIC_SITE_URL=http://localhost:3000


